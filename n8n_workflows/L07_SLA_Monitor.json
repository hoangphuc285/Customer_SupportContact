    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\n\nreturn items.map(item => {\n  const data = item.json;\n  const createdAt = new Date(data.created_at);\n  \n  // Tính số giờ đã trôi qua\n  const diffHours = Math.max(0, (now - createdAt) / (1000 * 60 * 60));\n  const targetHours = Number(data.resolution_time_hours) || 24;\n  const slaPercentage = Math.round((diffHours / targetHours) * 100);\n\n  let alertLevel = 'NORMAL';\n  if (slaPercentage >= 150) {\n    alertLevel = 'CRITICAL_150';\n  } else if (slaPercentage >= 100) {\n    alertLevel = 'BREACHED_100';\n  } else if (slaPercentage >= 80) {\n    alertLevel = 'WARNING_80';\n  }\n\n  // Cần thông báo khi mức alert thay đổi và không phải mức NORMAL\n  const needNotify = (alertLevel !== data.last_alert_level) && (alertLevel !== 'NORMAL');\n\n  return {\n    json: {\n      ...data,\n      hours_spent: Number(diffHours.toFixed(2)),\n      sla_percentage: slaPercentage,\n      alert_level: alertLevel,\n      need_notify: needNotify\n    }\n  };\n});"
      },
