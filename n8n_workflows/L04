    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const meta = $('Loop Over Documents').item.json;\nconst raw = $json.data ?? $json.text ?? $json.content ?? '';\nconst base = {\n  source_key: meta.source_key,\n  doc_title: meta.doc_title || meta.source_key,\n  category: meta.category || 'GENERAL',\n  language: meta.language || 'vi',\n  source_url: meta.source_url || ''\n};\n\n// Không dùng nội dung giả: nếu không đọc được thì báo lỗi, không nạp.\nif (typeof raw !== 'string' || raw.trim().length < 50) {\n  return { json: { ...base, ok: false, error_message: 'Không trích xuất được nội dung (file rỗng hoặc là PDF dạng ảnh scan)' } };\n}\n\nconst cleaned = raw\n  .normalize('NFC')\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/Page\\s+\\d+\\s+of\\s+\\d+/gi, '')\n  .replace(/Trang\\s+\\d+(\\s*\\/\\s*\\d+)?/gi, '')\n  .replace(/[-=_]{3,}/g, '')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n\\s*\\n+/g, '\\n\\n')\n  .trim();\n\nreturn { json: { ...base, ok: true, clean_text: cleaned } };"
      },
