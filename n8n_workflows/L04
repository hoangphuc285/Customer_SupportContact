      "parameters": {
        "jsCode": "const sum = $('Code - Tổng hợp nạp').first().json;\nconst items = $input.all().map(i => i.json);\nlet warn = sum.failed > 0;\nconst icon = { INGESTED: '✅', SKIPPED: '⏭', FAILED: '❌' };\n\nconst docLines = sum.details.map(d => {\n  if (d.status === 'FAILED') return `${icon.FAILED} ${d.doc_title}: LỖI - ${d.error_message}`;\n  if (d.status === 'SKIPPED') return `${icon.SKIPPED} ${d.doc_title}: không đổi (v${d.version}, ${d.chunk_count} chunk)`;\n  return `${icon.INGESTED} ${d.doc_title}: đã nạp ${d.chunk_count} chunk (v${d.version})`;\n});\n\nlet bench;\nif (items[0] && items[0].benchmark_skipped) {\n  bench = '🧪 Kiểm định: bỏ qua (không có tài liệu mới nạp)';\n} else {\n  const total = items.length;\n  const passed = items.filter(i => i.passed === true).length;\n  const rate = total ? Math.round(passed / total * 100) : 0;\n  if (rate < 80) warn = true;\n  const failedQ = items.filter(i => i.passed !== true).map(i => `   • Câu ${i.test_id}: ${i.question}`);\n  bench = `🧪 Kiểm định tự động: ${passed}/${total} câu đạt (${rate}%)` + (failedQ.length ? '\\n' + failedQ.join('\\n') : '');\n}\n\nconst head = warn ? '⚠️ [CẢNH BÁO - NẠP KHO TRI THỨC L04]' : '📚 [BÁO CÁO NẠP KHO TRI THỨC L04]';\nconst text = [\n  head,\n  `Tổng: ${sum.total} | Đã nạp: ${sum.ingested} | Bỏ qua: ${sum.skipped} | Lỗi: ${sum.failed}`,\n  '',\n  ...docLines,\n  '',\n  bench,\n  `🕒 ${new Date().toISOString()}`\n].join('\\n');\n\nreturn [{ json: { report_text: text, warn } }];"
      },
