        "jsCode": "const now = new Date();\nconst isMonday = now.getDay() === 1;\nconst periodType = isMonday ? 'WEEKLY' : 'DAILY';\n\nconst startDate = new Date(now.getTime() - (isMonday ? 7 : 1) * 24 * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    report_date: now.toISOString().split('T')[0],\n    report_time: now.toLocaleTimeString('vi-VN'),\n    period_type: periodType,\n    start_date: startDate.toISOString().split('T')[0],\n    end_date: now.toISOString().split('T')[0],\n    description: `Kỳ báo cáo ${periodType} từ ${startDate.toISOString().split('T')[0]} đến ${now.toISOString().split('T')[0]}`\n  }\n}];"
