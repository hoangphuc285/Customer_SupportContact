    {
      "parameters": {
        "jsCode": "const dateInfo = $('Date & Time - Xác định khoảng thời gian báo cáo').first().json;\nconst ticketMetrics = $('MySQL - Tổng hợp chỉ số Ticket & Phản hồi').first().json;\nconst opMetrics = $('MySQL - Tổng hợp Hoàn tiền, Bảo hành, Khiếu nại & QA').first().json;\nconst gaps = $('MySQL - Lấy lỗ hổng tri thức (knowledge_gaps)').all().map(i => i.json);\n\n// Anomaly Detection: Phân tích đột biến so với kỳ trước / ngưỡng chuẩn\nconst anomalies = [];\n\n// 1. Kiểm tra đột biến khiếu nại vận chuyển (Delivery)\nconst deliveryComplaints = Number(opMetrics.delivery_complaints) || 0;\nconst totalComplaints = Number(opMetrics.total_complaints) || 0;\nif (totalComplaints > 0 && (deliveryComplaints / totalComplaints) >= 0.7) {\n  anomalies.push(`⚠️ ĐỘT BIẾN KHIẾU NẠI VẬN CHUYỂN: Có ${deliveryComplaints}/${totalComplaints} ca khiếu nại (chiếm ${Math.round((deliveryComplaints/totalComplaints)*100)}%) liên quan đến giao hàng chậm/hư hỏng bao bì. Tăng mạnh so với ngưỡng cho phép (<30%).`);\n}\n\n// 2. Kiểm tra tỷ lệ vi phạm SLA\nconst slaBreachRate = Number(ticketMetrics.sla_breach_rate) || 0;\nif (slaBreachRate >= 15) {\n  anomalies.push(`⚠️ TỶ LỆ VI PHẠM SLA CAO: Đang ở mức ${slaBreachRate}% (vượt ngưỡng mục tiêu <10%), cần bổ sung nhân sự trực ca cao điểm.`);\n}\n\n// 3. Kiểm tra điểm QA\nconst avgQa = Number(opMetrics.avg_qa_score) || 0;\nif (avgQa < 70) {\n  anomalies.push(`⚠️ ĐIỂM QA TRUNG BÌNH THẤP: Đạt ${avgQa}/100, phát hiện nhân viên trả lời cộc lốc hoặc tư vấn sai thời hạn chính sách bảo hành/đổi trả.`);\n}\n\n// 4. Kiểm tra lỗ hổng tri thức (no_answer)\nif (gaps.length > 0) {\n  anomalies.push(`💡 LỖ HỔNG TRI THỨC (KNOWLEDGE GAPS): Ghi nhận ${gaps.length} câu hỏi khách hàng lặp lại mà chatbot chưa có sẵn câu trả lời chuẩn (chủ yếu về thời hạn đổi trả 7 ngày).`);\n}\n\nconst anomalyText = anomalies.length > 0 ? anomalies.join('\\n\\n') : \"✅ Tất cả các chỉ số vận hành đều nằm trong ngưỡng an toàn, không phát hiện đột biến bất thường.\";\n\nreturn [{\n  json: {\n    ...dateInfo,\n    ...ticketMetrics,\n    ...opMetrics,\n    knowledge_gaps: gaps,\n    anomalies: anomalies,\n    anomaly_analysis: anomalyText\n  }\n}];"
      },
