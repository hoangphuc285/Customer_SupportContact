      "parameters": {
        "jsCode": "const ctx = $('Code - Chuẩn hóa tham số đầu vào').first().json;\nconst rewritten = String($('Basic LLM Chain - Viết lại truy vấn độc lập').first().json.text || '').trim() || ctx.message;\nconst MIN_SCORE = 0.5;   // ngưỡng tương đồng tối thiểu (chỉnh theo model embedding)\n\nconst all = $input.all().map(i => i.json);\nconst retrievalError = all.some(j => j.error);\nconst chunks = all.filter(j => {\n  const content = j.document?.pageContent ?? j.pageContent ?? '';\n  const score = typeof j.score === 'number' ? j.score : null;\n  return typeof content === 'string' && content.trim().length > 10 && (score === null || score >= MIN_SCORE);\n});\nconst scores = chunks.map(j => j.score).filter(s => typeof s === 'number');\nconst sources = [...new Set(chunks.map(j => j.document?.metadata?.doc_title).filter(Boolean))];\n\nreturn [{ json: {\n  ...ctx,\n  rewritten_query: rewritten,\n  has_chunks: chunks.length > 0,\n  chunk_count: chunks.length,\n  top_score: scores.length ? Math.max(...scores) : null,\n  retrieval_error: retrievalError,\n  retrieved_sources: sources,\n  retrieved_context: chunks.map(j => {\n    const title = j.document?.metadata?.doc_title;\n    return (title ? '[' + title + '] ' : '') + (j.document?.pageContent ?? j.pageContent);\n  }).join('\\n---\\n')\n} }];"
