    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ctx = $('Code - Lọc chunk theo ngưỡng tương đồng').first().json;\n\n// Không bịa kết quả: không đọc được JSON hoặc thiếu câu trả lời => confidence 0 => chuyển người.\nlet parsed = null;\ntry {\n  if (item.output && typeof item.output === 'object') parsed = item.output;\n  else if (typeof item.output === 'string') parsed = JSON.parse(item.output);\n} catch (e) { parsed = null; }\n\nconst answer = String(parsed?.answer ?? '').trim();\nlet conf = Number(parsed?.confidence);\nif (!answer || !Number.isFinite(conf)) conf = 0;\nconf = Math.max(0, Math.min(1, conf));\n\n// Confidence tự chấm của LLM không đáng tin tuyệt đối: giới hạn trên theo độ tương đồng truy xuất.\nif (typeof ctx.top_score === 'number') {\n  const cap = ctx.top_score >= 0.7 ? 1 : (ctx.top_score >= 0.55 ? 0.79 : 0.49);\n  conf = Math.min(conf, cap);\n}\nconst sources = Array.isArray(parsed?.sources) ? parsed.sources.filter(Boolean).map(String) : [];\nconst safe = s => String(s).replace(/[<>&*_`\\[\\]]/g, ' ');\n\nreturn [{ json: {\n  ...ctx,\n  answer,\n  sources,\n  confidence: Number(conf.toFixed(2)),\n  confidence_level: conf >= 0.8 ? 'HIGH' : (conf >= 0.5 ? 'MEDIUM' : 'LOW'),\n  approved_by_human: false,\n  approval_text: [\n    '⚠️ DUYỆT CÂU TRẢ LỜI TỰ ĐỘNG - TICKET #' + ctx.ticket_code,\n    '',\n    '❓ Khách hỏi: ' + safe(ctx.message),\n    '🤖 AI đề xuất: ' + safe(answer),\n    '🎯 Độ tin cậy: ' + (conf * 100).toFixed(1) + '% (mức trung bình)',\n    '📚 Nguồn: ' + (sources.length ? safe(sources.join(', ')) : 'không rõ'),\n    '',\n    'Duyệt để gửi cho khách, hoặc từ chối để chuyển nhân viên xử lý.'\n  ].join('\\n')\n} }];"
