        "query": "SELECT\n  t.id,\n  t.ticket_code,\n  t.customer_id,\n  t.assignee_id,\n  t.channel,\n  t.priority,\n  t.status,\n  t.subject,\n  t.sla_breached,\n  COALESCE(t.last_alert_level, 0) AS last_alert_level,\n  t.created_at,\n  t.updated_at,\n  s.full_name AS assignee_name\nFROM tickets t\nLEFT JOIN staff s ON t.assignee_id = s.id\nWHERE t.status IN ('CLOSED', 'RESOLVED')\n  AND NOT EXISTS (SELECT 1 FROM qa_scores q WHERE q.ticket_id = t.id)\nORDER BY t.updated_at DESC\nLIMIT 20;",
