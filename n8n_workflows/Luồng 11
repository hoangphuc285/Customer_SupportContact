      "parameters": {
        "jsCode": "const items = $input.all();\nconst ticket = $('Loop Over Items').first()?.json;\n\nlet transcript = '';\nif (items.length === 0 || !items[0].json.id) {\n  transcript = `[Hệ thống]: Không tìm thấy lịch sử tin nhắn cho ticket #${ticket.ticket_code}. Khách hàng phản ánh vấn đề liên quan đến ${ticket.category || 'dịch vụ'}.`;\n} else {\n  transcript = items.map(it => {\n    const sender = it.json.sender_type === 'CUSTOMER' ? `[Khách hàng ${ticket.customer_name || ''}]` :\n                   it.json.sender_type === 'STAFF' ? `[Nhân viên: ${it.json.staff_name || ticket.staff_name || 'Hỗ trợ viên'}]` :\n                   it.json.sender_type === 'AI' ? `[AI Trợ lý]` :\n                   `[${it.json.sender_type}]`;\n    return `${sender}: ${it.json.content_original}`;\n  }).join('\\n');\n}\n\nconst checklist = [\n  \"1. Chào hỏi & Xưng hô chuẩn mực (0 - 10): Có lời chào đầu/kết lịch sự, xưng hô tôn trọng, đúng tác phong CSKH chuyên nghiệp.\",\n  \"2. Xác minh thông tin & Làm rõ vấn đề (0 - 10): Chủ động hỏi và xác minh rõ thông tin mã đơn/sản phẩm/triệu chứng lỗi trước khi đưa ra kết luận.\",\n  \"3. Tuân thủ chính sách & Quy trình (0 - 10): Hướng dẫn đúng chính sách đổi trả (7 ngày 1 đổi 1 tận nơi nếu lỗi NSX) và bảo hành (12 tháng chính hãng); không bịa đặt hoặc tự ý từ chối quyền lợi khách.\",\n  \"4. Thái độ & Giọng điệu chuyên nghiệp (0 - 10): Lắng nghe, kiên nhẫn, đồng cảm khi khách bức xúc, tuyệt đối không cộc lốc, vô trách nhiệm hay tranh cãi.\",\n  \"5. Giải quyết triệt để & Hướng dẫn tiếp theo (0 - 10): Đưa ra giải pháp rõ ràng, mốc giờ cam kết hoàn tất cụ thể, hướng dẫn các bước tiếp theo.\"\n];\n\nreturn [{\n  json: {\n    ticket_id: ticket.id,\n    ticket_code: ticket.ticket_code,\n    status: ticket.status,\n    priority: ticket.priority,\n    category: ticket.category || 'GENERAL',\n    staff_id: ticket.assignee_id,\n    staff_name: ticket.staff_name || 'Chưa gán',\n    customer_name: ticket.customer_name || 'Khách hàng',\n    csat_score: ticket.csat_score,\n    sample_reason: ticket.sample_reason,\n    conversation_transcript: transcript,\n    checklist_text: checklist.join('\\n')\n  }\n}];"
      },
