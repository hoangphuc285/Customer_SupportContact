    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0) {\n  return [];\n}\n\nconst sampled = [];\nconst remaining = [];\n\nitems.forEach(it => {\n  const t = it.json;\n  const isEscalated = t.status === 'ESCALATED' || t.sla_breached == 1 || (t.last_alert_level && t.last_alert_level >= 3);\n  const isLowCsat = t.csat_score !== null && t.csat_score !== undefined && Number(t.csat_score) <= 3;\n  \n  if (isEscalated) {\n    sampled.push({ ...t, sample_reason: 'ESCALATED' });\n  } else if (isLowCsat) {\n    sampled.push({ ...t, sample_reason: 'LOW_CSAT' });\n  } else {\n    remaining.push(t);\n  }\n});\n\n// Take 15% random sample of remaining (or at least 1 if remaining has items and sampled is small)\nconst sampleSize = Math.max(remaining.length > 0 && sampled.length < 3 ? 1 : 0, Math.ceil(remaining.length * 0.15));\nconst shuffled = remaining.sort(() => 0.5 - Math.random());\nfor (let i = 0; i < Math.min(sampleSize, shuffled.length); i++) {\n  sampled.push({ ...shuffled[i], sample_reason: 'RANDOM_SAMPLE' });\n}\n\nreturn sampled.map(s => ({ json: s }));"
      },
