    {
      "parameters": {
        "promptType": "define",
        "text": "=Bạn là chuyên viên Đảm bảo chất lượng (QA) dịch vụ chăm sóc khách hàng.\nHãy đánh giá cuộc hội thoại của ticket #{{ $('Loop Over Items').last()?.json?.ticket_code }} (Tiêu đề: {{ $('Loop Over Items').last()?.json?.subject || 'Hỗ trợ khách hàng' }}):\n\n{{ $('MySQL_Get_Messages').all().filter(m => m.json && (m.json.message_text || m.json.content_original)).map(m => (m.json.sender_type || 'SYSTEM') + ': ' + (m.json.message_text || m.json.content_original)).join('\\n') || '(Chưa có tin nhắn chi tiết trong hội thoại)' }}\n\nChấm điểm theo thang 0 - 100 cho 5 tiêu chí và CHỈ TRẢ VỀ đúng một JSON hợp lệ (không giải thích thêm):\n{\n  \"greeting\": 85,\n  \"understanding\": 85,\n  \"policy_accuracy\": 85,\n  \"tone\": 90,\n  \"resolution\": 85,\n  \"has_critical_violation\": false,\n  \"violations\": \"Không phát hiện vi phạm quy trình.\",\n  \"summary\": \"Nhân viên/AI phản hồi lịch sự, đúng trọng tâm.\",\n  \"coaching_tip\": \"Tiếp tục duy trì tác phong chuẩn mực.\"\n}\nLưu ý: Chỉ đánh dấu has_critical_violation = true nếu phía Nhân viên/AI xúc phạm, chửi bới hoặc bịa đặt thông tin nghiêm trọng.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        272
      ],
      "id": "0e4785e3-3d98-4966-a4f0-3bcf1724e03b",
      "name": "AI_Agent_QA",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Loop Over Items').last()?.json || {};\nconst msgs = $('MySQL_Get_Messages').all().map(m => m.json).filter(m => m && (m.message_text || m.content_original));\nconst rawItem = $input.first();\nconst rawText = String(rawItem?.json?.output || rawItem?.json?.text || '');\n\nlet parsed = null;\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\nif (jsonMatch) {\n  try {\n    parsed = JSON.parse(jsonMatch[0]);\n  } catch (e) {\n    parsed = null;\n  }\n}\n\nconst toScale100 = (val, fallback) => {\n  const n = Number(val);\n  if (!Number.isFinite(n)) return fallback;\n  const scaled = (n > 0 && n <= 10) ? n * 10 : n;\n  return Math.max(0, Math.min(100, Math.round(scaled)));\n};\n\nconst extractRegexScore = (keys, fallback) => {\n  for (const key of keys) {\n    const r = new RegExp(`${key}[^0-9]*([0-9]+(?:\\\\.[0-9]+)?)`, 'i');\n    const m = rawText.match(r);\n    if (m) return toScale100(m[1], fallback);\n  }\n  return fallback;\n};\n\nconst outbound = msgs.filter(m => m.sender_type === 'STAFF' || m.sender_type === 'AI')\n  .map(m => String(m.message_text || m.content_original || ''));\nconst outboundJoined = outbound.join('\\n').toLowerCase();\nconst polite = ['xin chào', 'chào', 'cảm ơn', 'xin lỗi', 'dạ', 'trân trọng', 'quý khách', 'hello'].some(t => outboundJoined.includes(t));\nconst breached = Array.isArray(ticket.sla_breached?.data)\n  ? Boolean(ticket.sla_breached.data[0])\n  : Boolean(ticket.sla_breached);\n\nconst fallbackGreeting = outbound.length === 0 ? 65 : (polite ? 88 : 74);\nconst fallbackUnderstanding = outbound.length === 0 ? 65 : 84;\nconst fallbackPolicy = breached ? 68 : 86;\nconst fallbackTone = outbound.length === 0 ? 70 : (polite ? 90 : 78);\nconst fallbackResolution = outbound.length === 0 ? 70 : (breached ? 75 : 88);\n\nconst greeting = parsed ? toScale100(parsed.greeting ?? parsed.greeting_score, fallbackGreeting) : extractRegexScore(['greeting', 'greeting_score'], fallbackGreeting);\nconst understanding = parsed ? toScale100(parsed.understanding ?? parsed.understanding_score, fallbackUnderstanding) : extractRegexScore(['understanding', 'understanding_score'], fallbackUnderstanding);\nconst policyAccuracy = parsed ? toScale100(parsed.policy_accuracy ?? parsed.policy_accuracy_score, fallbackPolicy) : extractRegexScore(['policy_accuracy', 'policy_accuracy_score'], fallbackPolicy);\nconst tone = parsed ? toScale100(parsed.tone ?? parsed.tone_score, fallbackTone) : extractRegexScore(['tone', 'tone_score'], fallbackTone);\nconst resolution = parsed ? toScale100(parsed.resolution ?? parsed.resolution_score, fallbackResolution) : extractRegexScore(['resolution', 'resolution_score'], fallbackResolution);\n\nconst totalScore = Number(((greeting + understanding + policyAccuracy + tone + resolution) / 5).toFixed(1));\nconst hasViolation = parsed\n  ? Boolean(parsed.has_critical_violation)\n  : /has_critical_violation\\s*[:=]\\s*true/i.test(rawText);\n\nlet grade = 'PASS';\nif (totalScore < 50 || hasViolation) {\n  grade = 'FAIL';\n} else if (totalScore < 75) {\n  grade = 'NEEDS_IMPROVEMENT';\n}\n\nconst violations = (parsed && parsed.violations)\n  ? String(parsed.violations)\n  : (hasViolation ? 'Phát hiện vi phạm nghiêm trọng trong hội thoại.' : (breached ? 'Ticket bị vi phạm SLA.' : 'Không phát hiện vi phạm quy trình.'));\nconst summary = (parsed && parsed.summary)\n  ? String(parsed.summary)\n  : `Đạt ${totalScore}/100 điểm (${grade}) qua ${msgs.length} tin nhắn.`;\nconst coachingTip = (parsed && parsed.coaching_tip)\n  ? String(parsed.coaching_tip)\n  : 'Duy trì thái độ lịch sự, bám sát chính sách và phản hồi kịp thời.';\n\nconst scores = {\n  greeting,\n  understanding,\n  policy_accuracy: policyAccuracy,\n  tone,\n  resolution\n};\n\nconst escSql = (s) => String(s ?? '').replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"''\");\nconst scoresJson = JSON.stringify(scores);\n\nreturn [{\n  json: {\n    ticket_id: ticket.id,\n    ticket_code: ticket.ticket_code,\n    staff_id: ticket.assignee_id || null,\n    scores,\n    scores_sql: escSql(scoresJson),\n    total_score: totalScore,\n    grade,\n    critical_violation: hasViolation ? 1 : 0,\n    critical_violation_bool: hasViolation,\n    violations,\n    violations_sql: escSql(violations),\n    summary,\n    summary_sql: escSql(summary),\n    coaching_tip: coachingTip,\n    coaching_tip_sql: escSql(coachingTip)\n  }\n}];"
      },
