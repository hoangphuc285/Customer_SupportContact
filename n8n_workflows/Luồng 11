      "parameters": {
        "jsCode": "const valid = $input.all().filter(item => item.json && item.json.id);\nif (valid.length === 0) {\n  return [{ json: { id: null, has_tickets: false } }];\n}\n\nconst sampled = valid.length <= 10\n  ? valid\n  : valid.filter(item => {\n      const breached = Array.isArray(item.json.sla_breached?.data)\n        ? Boolean(item.json.sla_breached.data[0])\n        : Boolean(item.json.sla_breached);\n      const isPriority = breached || Number(item.json.last_alert_level || 0) > 0 || item.json.priority === 'P1';\n      return isPriority || Math.random() < 0.3;\n    });\n\nconst finalItems = sampled.length > 0 ? sampled : valid.slice(0, 1);\nreturn finalItems.map(item => ({\n  json: {\n    ...item.json,\n    has_tickets: true\n  }\n}));"
