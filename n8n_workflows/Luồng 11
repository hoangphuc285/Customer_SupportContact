    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst prep = $('Code - Chuẩn bị nội dung hội thoại & Checklist QA').first().json;\n\nlet parsed = {};\ntry {\n  if (typeof item.output === 'object' && item.output !== null) {\n    parsed = item.output;\n  } else if (typeof item.output === 'string') {\n    let clean = item.output.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(clean);\n  } else if (typeof item.text === 'string') {\n    let clean = item.text.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(clean);\n  } else if (item.scores) {\n    parsed = item;\n  }\n} catch (e) {\n  parsed = {\n    scores: { greeting: 7, verification: 7, policy_compliance: 7, tone_attitude: 7, resolution: 7 },\n    violations: [],\n    critical_violation: false,\n    summary: item.output || item.text || \"Đã đánh giá chất lượng hội thoại.\"\n  };\n}\n\nconst scores = parsed.scores || { greeting: 7, verification: 7, policy_compliance: 7, tone_attitude: 7, resolution: 7 };\nconst greeting = Number(scores.greeting) || 0;\nconst verification = Number(scores.verification) || 0;\nconst policy = Number(scores.policy_compliance || scores.policy) || 0;\nconst tone = Number(scores.tone_attitude || scores.tone) || 0;\nconst resolution = Number(scores.resolution) || 0;\n\n// Raw total out of 50 -> scaled to 100\nconst rawTotal = greeting + verification + policy + tone + resolution;\nconst totalScore = Math.min(100, Math.max(0, rawTotal * 2));\n\nconst criticalViolation = Boolean(parsed.critical_violation || (policy <= 3 || tone <= 3));\nlet grade = 'PASS';\nif (criticalViolation || totalScore < 60) {\n  grade = 'FAIL';\n} else if (totalScore < 80) {\n  grade = 'NEEDS_IMPROVEMENT';\n}\n\nconst violations = Array.isArray(parsed.violations) ? parsed.violations : [];\nconst violationsText = violations.join('; ');\n\nreturn [{\n  json: {\n    ticket_id: prep.ticket_id,\n    ticket_code: prep.ticket_code,\n    status: prep.status,\n    priority: prep.priority,\n    category: prep.category,\n    staff_id: prep.staff_id,\n    staff_name: prep.staff_name,\n    customer_name: prep.customer_name,\n    csat_score: prep.csat_score,\n    sample_reason: prep.sample_reason,\n    scores: {\n      greeting,\n      verification,\n      policy_compliance: policy,\n      tone_attitude: tone,\n      resolution\n    },\n    total_score: totalScore,\n    grade: grade,\n    critical_violation: criticalViolation,\n    violations: violations,\n    violations_text: violationsText,\n    summary: parsed.summary || 'Đã hoàn tất đánh giá chất lượng hội thoại.'\n  }\n}];"
      },
