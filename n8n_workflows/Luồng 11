    {
      "parameters": {
        "promptType": "define",
        "text": "=Bạn là chuyên viên Đảm bảo chất lượng (QA) dịch vụ chăm sóc khách hàng.\nHãy đánh giá cuộc hội thoại sau giữa Khách hàng (customer) và Nhân viên hỗ trợ (agent):\n\n{{ $('MySQL_Get_Messages').all().map(m => m.json.sender_type + ': ' + m.json.content).join('\\n') }}\n\nTiêu chí chấm điểm (thang điểm 0 - 10):\n- greeting_score: Chào hỏi, xưng hô lịch sự\n- understanding_score: Mức độ hiểu đúng vấn đề của khách\n- policy_accuracy_score: Cung cấp đúng chính sách, thông tin chuẩn xác\n- tone_score: Thái độ nhã nhặn, chuẩn mực\n- resolution_score: Giải quyết triệt để vấn đề\n\nNếu nhân viên có thái độ xúc phạm, chửi bới, hoặc bịa đặt thông tin sai lệch nghiêm trọng, hãy đánh dấu has_critical_violation = true (ngược lại là false).",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        160,
        272
      ],
      "id": "0e4785e3-3d98-4966-a4f0-3bcf1724e03b",
      "name": "AI_Agent_QA"
    },
    {
      "parameters": {
        "jsCode": "// Lấy output từ AI Agent (chỉ lấy bản ghi đầu tiên để tránh bị trùng item)\nconst rawItem = $input.first();\nconst text = rawItem.json.output || rawItem.json.text || '';\n\n// Regex trích xuất điểm số từ văn bản đánh giá của AI\nconst getScore = (fieldName, defaultVal = 8) => {\n  const regex = new RegExp(`${fieldName}[^0-9]*([0-9]+(?:\\\\.[0-9]+)?)\\\\s*\\\\/\\\\s*10`, 'i');\n  const match = text.match(regex);\n  return match ? parseFloat(match[1]) : defaultVal;\n};\n\nconst greeting = getScore('greeting_score', 8);\nconst understanding = getScore('understanding_score', 8);\nconst policy = getScore('policy_accuracy_score', 8);\nconst tone = getScore('tone_score', 8);\nconst resolution = getScore('resolution_score', 8);\n\nconst total = (greeting + understanding + policy + tone + resolution) / 5;\n\n// Kiểm tra vi phạm nghiêm trọng\nconst hasViolation = /has_critical_violation\\s*[:=]\\s*true/i.test(text) || text.includes('vi phạm nghiêm trọng');\n\nlet grade = 'PASSED';\nif (total < 5 || hasViolation) {\n  grade = 'FAILED';\n} else if (total < 7.5) {\n  grade = 'NEEDS_IMPROVEMENT';\n}\n\nreturn [\n  {\n    json: {\n      ticket_id: $('Loop Over Items').item.json.id,\n      total_score: Number(total.toFixed(2)),\n      grade: grade,\n      has_violation: hasViolation ? 1 : 0,\n      details: text.length > 500 ? text.substring(0, 500) + '...' : text\n    }\n  }\n];"
      },
