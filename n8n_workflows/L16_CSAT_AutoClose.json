    {
      "id": "03534b63-6cd7-4463-8b45-acf413e9ff41",
      "name": "Code – Soạn tin CSAT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        20
      ],
      "parameters": {
        "jsCode": "const cfg = $('Edit Fields – Hằng số cấu hình L16').first().json;\nreturn $input.all().map(item => {\n  const t = item.json;\n  const ticketId = t.ticketId;\n  const ticketCode = t.ticketCode || ('#' + ticketId);\n  const channel = (t.channel || 'WEB').toUpperCase();\n  const token = t.csatToken || '';\n  const baseUrl = `${cfg.PORTAL_BASE_URL}/csat?ticketId=${ticketId}&token=${token}`;\n\n  const replyMarkup = {\n    inline_keyboard: [[\n      { text: '⭐ 1', callback_data: `csat:${ticketId}:1` },\n      { text: '⭐⭐ 2', callback_data: `csat:${ticketId}:2` },\n      { text: '⭐⭐⭐ 3', callback_data: `csat:${ticketId}:3` },\n      { text: '⭐⭐⭐⭐ 4', callback_data: `csat:${ticketId}:4` },\n      { text: '⭐⭐⭐⭐⭐ 5', callback_data: `csat:${ticketId}:5` }\n    ]]\n  };\n\n  let content = `Cảm ơn Quý khách đã liên hệ VKU Store về yêu cầu ${ticketCode}. Quý khách vui lòng đánh giá mức độ hài lòng từ 1 đến 5 sao:`;\n  if (channel === 'EMAIL' || channel === 'WEB' || channel === 'LIVECHAT') {\n    content += `\\nĐánh giá nhanh tại: ${baseUrl}`;\n  }\n\n  return {\n    json: {\n      ticket_id: ticketId,\n      ticket_code: ticketCode,\n      channel,\n      sender_type: 'SYSTEM',\n      content,\n      reply_markup: channel === 'TELEGRAM' ? replyMarkup : null,\n      needs_translation: (t.preferredLanguage && t.preferredLanguage !== 'vi')\n    }\n  };\n});"
      }
    },
