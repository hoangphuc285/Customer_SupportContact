    {
      "id": "97e484e3-a5bb-4c0b-bb8e-bd16fba7ec3c",
      "name": "Code – Kiểm tra callback Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        960
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json || {};\nconst cbData = String(d.callback_data || '');\nconst parts = cbData.split(':');\nif (parts.length !== 3 || parts[0] !== 'csat') {\n  throw new Error('Callback data không hợp lệ: ' + cbData);\n}\nconst ticketId = Number(parts[1]);\nconst score = Number(parts[2]);\nif (!ticketId || score < 1 || score > 5) {\n  throw new Error('ticketId hoặc score không hợp lệ');\n}\nreturn [{\n  json: {\n    ticket_id: ticketId,\n    score,\n    source: 'TELEGRAM',\n    chat_id: d.chat_id ? String(d.chat_id) : null,\n    message_id: d.message_id || null,\n    callback_query_id: d.callback_query_id || null\n  }\n}];"
      }
    },
