      "parameters": {
        "jsCode": "const cfg = $('Edit Fields – Hằng số cấu hình L16').first().json;\nreturn $input.all().map(item => {\n  const t = item.json;\n  const ticketId = t.ticketId;\n  const ticketCode = t.ticketCode || ('#' + ticketId);\n  const channel = (t.channel || 'WEB').toUpperCase();\n  const replyMarkup = channel === 'TELEGRAM' ? {\n    inline_keyboard: [[\n      { text: '⭐ 1', callback_data: `csat:${ticketId}:1` },\n      { text: '⭐⭐ 2', callback_data: `csat:${ticketId}:2` },\n      { text: '⭐⭐⭐ 3', callback_data: `csat:${ticketId}:3` },\n      { text: '⭐⭐⭐⭐ 4', callback_data: `csat:${ticketId}:4` },\n      { text: '⭐⭐⭐⭐⭐ 5', callback_data: `csat:${ticketId}:5` }\n    ]]\n  } : null;\n  const content = `Nhắc nhẹ: VKU Store rất mong nhận được đánh giá của Quý khách cho yêu cầu ${ticketCode} để cải thiện chất lượng phục vụ.`;\n  return {\n    json: {\n      ticket_id: ticketId,\n      ticket_code: ticketCode,\n      channel,\n      sender_type: 'SYSTEM',\n      content,\n      reply_markup: replyMarkup\n    }\n  };\n});"
