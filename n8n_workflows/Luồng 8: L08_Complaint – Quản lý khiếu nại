      "parameters": {
        "jsCode": "const complaintType = $('Text Classifier - Loại khiếu nại').item.json.category || 'OTHER';\nconst severity = $('Text Classifier - Mức nghiêm trọng').item.json.category || 'MINOR';\nconst target = ($('Information Extractor').item.json.output?.complaint_target || '').toLowerCase();\n\nlet deptId = 1;\nlet deptCode = 'SUPPORT';\nlet deptName = 'Chăm sóc khách hàng';\nlet deptEmail = 'support@support.local';\n\nif (complaintType === 'PRODUCT') {\n  if (target.includes('kho') || target.includes('đóng gói') || target.includes('bao bì')) {\n    deptId = 2;\n    deptCode = 'WAREHOUSE';\n    deptName = 'Kho';\n    deptEmail = 'warehouse@support.local';\n  } else {\n    deptId = 4;\n    deptCode = 'TECH';\n    deptName = 'Kỹ thuật';\n    deptEmail = 'tech@support.local';\n  }\n} else if (complaintType === 'DELIVERY') {\n  deptId = 3;\n  deptCode = 'DELIVERY';\n  deptName = 'Giao hàng';\n  deptEmail = 'delivery@support.local';\n} else if (complaintType === 'PAYMENT') {\n  deptId = 5;\n  deptCode = 'ACCOUNTING';\n  deptName = 'Kế toán';\n  deptEmail = 'accounting@support.local';\n} else if (complaintType === 'STAFF') {\n  deptId = 6;\n  deptCode = 'SALES';\n  deptName = 'Kinh doanh';\n  deptEmail = 'sales@support.local';\n}\n\nlet priority = 'P3';\nif (severity === 'CRITICAL') priority = 'P1';\nelse if (severity === 'MAJOR') priority = 'P2';\n\nreturn [{\n  json: {\n    department_id: deptId,\n    department_code: deptCode,\n    department_name: deptName,\n    department_email: deptEmail,\n    complaint_type: complaintType,\n    severity: severity,\n    priority: priority\n  }\n}];"
      },
