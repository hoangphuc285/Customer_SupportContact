        "jsCode": "// Lấy trực tiếp dữ liệu từ node liền trước (Execute a SQL query)\nconst inputData = $input.first().json;\nconst text = inputData.content_original || \"\";\nconst lower = text.toLowerCase();\n\n// 1. Quét từ khóa nguy hiểm\nlet keywordScore = 0;\nif (lower.includes(\"kiện\")) keywordScore += 30;\nif (lower.includes(\"báo chí\")) keywordScore += 35;\nif (lower.includes(\"công an\")) keywordScore += 40;\nif (lower.includes(\"lừa đảo\")) keywordScore += 35;\nif (lower.includes(\"tố cáo\")) keywordScore += 40;\n\n// 2. Phân tích cảm xúc (Sentiment)\nlet sentimentScore = 20;\nif (lower.includes(\"đột ngột\") || lower.includes(\"tồi tệ\")) {\n    sentimentScore = 25;\n}\n\n// 3. Tổng hợp điểm rủi ro (Risk Score)\nlet riskScore = keywordScore + sentimentScore;\nif (riskScore > 100) riskScore = 100;\n\n// 4. Phân loại mức độ rủi ro\nlet riskLevel = \"LOW\";\nif (riskScore > 70) {\n    riskLevel = \"HIGH\";\n} else if (riskScore >= 40) {\n    riskLevel = \"MEDIUM\";\n}\n\nreturn [{\n    json: {\n        ticket_id: inputData.ticket_id,\n        customer_id: inputData.customer_id,\n        content_original: text,\n        keywordScore,\n        sentimentScore,\n        riskScore,\n        riskLevel\n    }\n}];"
