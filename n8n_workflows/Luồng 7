    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json;\nconst now = new Date();\nconst created = new Date(ticket.created_at);\n\nconst totalElapsedMinutes = Math.max(1, Math.floor((now - created) / 60000));\n\nlet businessMinutes = 0;\nlet cur = new Date(created.getTime());\nwhile (cur < now) {\n  const day = cur.getDay();\n  const hour = cur.getHours();\n  if (day >= 1 && day <= 5 && hour >= 8 && hour < 18) {\n    businessMinutes += 1;\n  }\n  cur = new Date(cur.getTime() + 60000);\n}\nif (businessMinutes === 0) businessMinutes = totalElapsedMinutes;\n\nconst slaMinutes = ticket.sla_resolution_minutes || 1440;\nconst percentUsed = Math.round((totalElapsedMinutes / slaMinutes) * 100);\n\nlet alertLevel = 0;\nlet alertLevelName = 'AN TOÀN (<50%)';\n\nif (percentUsed > 150) {\n  alertLevel = 4;\n  alertLevelName = 'NGHIÊM TRỌNG (>150%)';\n} else if (percentUsed >= 100) {\n  alertLevel = 3;\n  alertLevelName = 'QUÁ HẠN (100-150%)';\n} else if (percentUsed >= 80) {\n  alertLevel = 2;\n  alertLevelName = 'CẢNH BÁO CAO (80-100%)';\n} else if (percentUsed >= 50) {\n  alertLevel = 1;\n  alertLevelName = 'THEO DÕI (50-80%)';\n}\n\nconst lastLevel = ticket.last_alert_level || 0;\nconst shouldAlert = alertLevel >= 2 && alertLevel > lastLevel;\n\nconst newPromisedDate = new Date(now.getTime() + 4 * 3600000);\nconst newPromisedStr = newPromisedDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ngày ' + newPromisedDate.toLocaleDateString('vi-VN');\n\nreturn [{\n  json: {\n    ...ticket,\n    elapsed_minutes: totalElapsedMinutes,\n    business_minutes: businessMinutes,\n    percent_used: percentUsed,\n    current_alert_level: alertLevel,\n    alert_level_name: alertLevelName,\n    should_alert: shouldAlert,\n    new_promised_at: newPromisedStr\n  }\n}];"
      },
