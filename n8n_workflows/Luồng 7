    {
      "parameters": {
        "jsCode": "const ticket = $input.first().json;\nconst now = new Date();\nconst created = ticket.created_at ? new Date(ticket.created_at) : now;\nconst due = ticket.due_at ? new Date(ticket.due_at) : null;\n\nconst totalElapsedMinutes = Math.max(1, Math.floor((now.getTime() - created.getTime()) / 60000));\n\n// Tinh so phut gio hanh chinh (T2-T6, 08:00-18:00) theo tung ngay de khong bi treo vong lap voi ticket cu\nfunction calcBusinessMinutes(startDate, endDate) {\n  if (endDate <= startDate) return 0;\n  const diffDays = Math.floor((endDate.getTime() - startDate.getTime()) / 86400000);\n  if (diffDays > 30) {\n    // Uoc luong nhanh cho ticket qua lau (>30 ngay)\n    return Math.round(((endDate.getTime() - startDate.getTime()) / 60000) * (50 / 168));\n  }\n  let total = 0;\n  const dayStart = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());\n  const endDay = new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate());\n  for (let d = new Date(dayStart); d <= endDay; d.setDate(d.getDate() + 1)) {\n    const dow = d.getDay();\n    if (dow === 0 || dow === 6) continue;\n    const workStart = new Date(d.getFullYear(), d.getMonth(), d.getDate(), 8, 0, 0).getTime();\n    const workEnd = new Date(d.getFullYear(), d.getMonth(), d.getDate(), 18, 0, 0).getTime();\n    const overlapStart = Math.max(workStart, startDate.getTime());\n    const overlapEnd = Math.min(workEnd, endDate.getTime());\n    if (overlapEnd > overlapStart) {\n      total += Math.floor((overlapEnd - overlapStart) / 60000);\n    }\n  }\n  return total;\n}\n\nlet businessMinutes = calcBusinessMinutes(created, now);\nif (businessMinutes === 0) businessMinutes = totalElapsedMinutes;\n\nconst slaMinutes = (due && due.getTime() > created.getTime())\n  ? Math.max(1, Math.round((due.getTime() - created.getTime()) / 60000))\n  : (Number(ticket.sla_resolution_minutes) || 1440);\n\nlet percentUsed = Math.round((totalElapsedMinutes / slaMinutes) * 100);\nif (due && due.getTime() < now.getTime() && percentUsed < 100) {\n  percentUsed = 100;\n}\n\nlet alertLevel = 0;\nlet alertLevelName = 'AN TOÀN (<50%)';\n\nif (percentUsed > 150) {\n  alertLevel = 4;\n  alertLevelName = 'NGHIÊM TRỌNG (>150%)';\n} else if (percentUsed >= 100) {\n  alertLevel = 3;\n  alertLevelName = 'QUÁ HẠN (100-150%)';\n} else if (percentUsed >= 80) {\n  alertLevel = 2;\n  alertLevelName = 'CẢNH BÁO CAO (80-100%)';\n} else if (percentUsed >= 50) {\n  alertLevel = 1;\n  alertLevelName = 'THEO DÕI (50-80%)';\n}\n\nconst lastLevel = Number(ticket.last_alert_level || 0);\nconst wasBreached = Array.isArray(ticket.sla_breached?.data)\n  ? Boolean(ticket.sla_breached.data[0])\n  : Boolean(ticket.sla_breached);\nconst isBreached = wasBreached || percentUsed >= 100 || (due !== null && due.getTime() < now.getTime());\nconst shouldAlert = alertLevel >= 2 && alertLevel > lastLevel;\nconst needsSync = shouldAlert || (isBreached && !wasBreached);\n\nconst newPromisedDate = new Date(now.getTime() + 4 * 3600000);\nconst newPromisedStr = newPromisedDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ngày ' + newPromisedDate.toLocaleDateString('vi-VN');\n\nreturn [{\n  json: {\n    ...ticket,\n    elapsed_minutes: totalElapsedMinutes,\n    business_minutes: businessMinutes,\n    sla_resolution_minutes: slaMinutes,\n    percent_used: percentUsed,\n    current_alert_level: alertLevel,\n    alert_level_name: alertLevelName,\n    is_breached: isBreached,\n    should_alert: shouldAlert,\n    needs_sync: needsSync,\n    new_promised_at: newPromisedStr\n  }\n}];"
      },
