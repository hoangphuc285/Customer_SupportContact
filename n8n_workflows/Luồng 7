      "parameters": {
        "jsCode": "const allTickets = $('MySQL - Lấy ticket chưa đóng & luật SLA').all().map(i => i.json);\n\nlet total = allTickets.length;\nlet safeCount = 0;\nlet warning80 = 0;\nlet breached100 = 0;\nlet critical150 = 0;\nlet details = [];\n\nconst now = new Date();\n\nallTickets.forEach(t => {\n  const created = t.created_at ? new Date(t.created_at) : now;\n  const due = t.due_at ? new Date(t.due_at) : null;\n  const elapsed = Math.max(1, Math.floor((now.getTime() - created.getTime()) / 60000));\n  const sla = (due && due.getTime() > created.getTime())\n    ? Math.max(1, Math.round((due.getTime() - created.getTime()) / 60000))\n    : (Number(t.sla_resolution_minutes) || 1440);\n  let pct = Math.round((elapsed / sla) * 100);\n  if (due && due.getTime() < now.getTime() && pct < 100) pct = 100;\n\n  if (pct > 150) critical150++;\n  else if (pct >= 100) breached100++;\n  else if (pct >= 80) warning80++;\n  else safeCount++;\n\n  details.push({\n    ticket_code: t.ticket_code,\n    priority: t.priority,\n    percent_used: pct + '%',\n    assignee: t.assignee_name || 'Chưa gán',\n    status: t.status\n  });\n});\n\nreturn [{\n  json: {\n    total_tickets: total,\n    safe_count: safeCount,\n    warning_80_count: warning80,\n    breached_100_count: breached100,\n    critical_150_count: critical150,\n    sla_compliance_rate: total > 0 ? Math.round(((total - (breached100 + critical150)) / total) * 100) : 100,\n    details: details\n  }\n}];"
