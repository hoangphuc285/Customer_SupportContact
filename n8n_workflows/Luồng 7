    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  t.id AS ticket_id,\n  t.ticket_code,\n  t.status,\n  t.priority,\n  COALESCE(t.category, t.intent, 'DEFAULT') AS category,\n  t.due_at,\n  t.created_at,\n  t.updated_at,\n  t.first_response_at,\n  t.assignee_id,\n  t.customer_id,\n  t.department_id,\n  COALESCE(t.last_alert_level, 0) AS last_alert_level,\n  t.sla_breached,\n  c.full_name AS customer_name,\n  c.email AS customer_email,\n  c.telegram_id AS customer_telegram_id,\n  s.full_name AS assignee_name,\n  s.email AS assignee_email,\n  s.telegram_chat_id AS assignee_telegram_id,\n  s.current_load AS assignee_current_load,\n  COALESCE(sr.resolution_minutes, sr_def.resolution_minutes, 1440) AS sla_resolution_minutes,\n  COALESCE(sr.first_response_minutes, sr_def.first_response_minutes, 60) AS sla_first_response_minutes,\n  COALESCE(sr.category, sr_def.category, 'DEFAULT') AS matched_sla_category\nFROM tickets t\nLEFT JOIN customers c ON t.customer_id = c.id\nLEFT JOIN staff s ON t.assignee_id = s.id\nLEFT JOIN sla_rules sr ON (sr.category = COALESCE(t.category, t.intent) AND sr.priority = t.priority)\nLEFT JOIN sla_rules sr_def ON (sr_def.category = 'DEFAULT' AND sr_def.priority = t.priority)\nWHERE t.status NOT IN ('CLOSED', 'RESOLVED')\nORDER BY t.created_at ASC;",
        "options": {}
      },
