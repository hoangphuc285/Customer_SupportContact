      "parameters": {
        "jsCode": "const orderData = $('Code - Kiểm tra thời hạn đổi trả (7 ngày)').first().json;\nconst extracted = $('Information Extractor').first().json.output || {};\nconst totalAmount = Number(orderData.total_amount) || 0;\nconst shippingFee = Number(orderData.shipping_fee) || 0;\n\n// Phân tích nguyên nhân:\n// Nếu do lỗi kỹ thuật/vận chuyển hỏng -> Hoàn 100% bao gồm cả phí ship\n// Nếu do khách đổi ý cá nhân -> Hoàn tiền hàng, trừ phí ship\nlet refundAmount = totalAmount;\nconst reasonLower = (extracted.reason || '').toLowerCase();\n\nif (reasonLower.includes('đổi ý') || reasonLower.includes('không thích') || reasonLower.includes('mua nhầm')) {\n  refundAmount = Math.max(0, totalAmount - shippingFee);\n}\n\n// Nếu khách yêu cầu số tiền cụ thể nhỏ hơn thì lấy theo yêu cầu của khách\nif (extracted.amount_requested && extracted.amount_requested > 0 && extracted.amount_requested < refundAmount) {\n  refundAmount = extracted.amount_requested;\n}\n\nreturn [{\n  json: {\n    ...orderData,\n    final_refund_amount: refundAmount,\n    refund_policy_reason: refundAmount === totalAmount ? 'Hoàn 100% (lỗi kỹ thuật/giao hàng)' : 'Hoàn tiền hàng trừ phí ship (lý do cá nhân)',\n    reason: extracted.reason || 'Khách hàng yêu cầu hoàn tiền'\n  }\n}];"
