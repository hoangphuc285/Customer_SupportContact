    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nif (!data.delivered_at) {\n  return [{\n    json: {\n      ...data,\n      within_return_window: true,\n      days_since_delivery: 0\n    }\n  }];\n}\n\nconst deliveredDate = new Date(data.delivered_at);\nconst now = new Date();\nconst diffDays = Math.floor((now - deliveredDate) / (1000 * 60 * 60 * 24));\n\n// Quy định đổi trả hoàn tiền trong vòng 7 ngày\nconst isWithinWindow = diffDays <= 7;\n\nreturn [{\n  json: {\n    ...data,\n    days_since_delivery: diffDays,\n    within_return_window: isWithinWindow,\n    return_window_message: isWithinWindow ? 'Trong thời hạn 7 ngày hợp lệ' : `Đã quá hạn đổi trả (${diffDays} ngày > 7 ngày)`\n  }\n}];"
