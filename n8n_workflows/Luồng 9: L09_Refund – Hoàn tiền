      "parameters": {
        "jsCode": "const prev = $('Code - Tính số tiền hoàn').first().json;\nconst fraud = $('MySQL - Chống gian lận (90 ngày)').first().json;\nconst triggerData = $('Code - Chuẩn hóa đầu vào Refund').first().json;\n\nlet evidenceUrl = triggerData.evidence_url || '';\ntry {\n  evidenceUrl = $('Wait - Yêu cầu ảnh bằng chứng').first()?.json?.body?.evidence_url || evidenceUrl;\n} catch(e) {}\n\nlet level = 'AUTO';\nlet approverId = null;\nlet approverRole = 'Hệ thống tự động';\n\nif (prev.final_refund_amount <= 500000 && fraud.fraud_flag === 0) {\n  level = 'AUTO';\n  approverId = null;\n  approverRole = 'AUTO';\n} else if (prev.final_refund_amount <= 5000000) {\n  level = 'TEAM_LEAD';\n  approverId = 3;\n  approverRole = 'Trưởng nhóm CSKH';\n} else {\n  level = 'MANAGER';\n  approverId = 2;\n  approverRole = 'Quản lý CSKH';\n}\n\nconst now = new Date();\nconst dateStr = now.toISOString().slice(0,10).replace(/-/g,'');\nconst randomCode = Math.floor(Math.random() * 8999 + 1000);\nconst refundCode = `REF-${dateStr}-${randomCode}`;\nconst paymentRef = `PAY_REF_${Math.floor(Math.random() * 899999 + 100000)}`;\n\nreturn [{\n  json: {\n    ...prev,\n    ...fraud,\n    evidence_url: evidenceUrl,\n    ticket_id: triggerData.ticket_id || 1,\n    approval_level: level,\n    approved_by_id: approverId,\n    approver_role: approverRole,\n    refund_code: refundCode,\n    payment_ref: paymentRef,\n    customer_name: prev.customer_name || triggerData.customer_name || 'Quý khách',\n    customer_email: prev.customer_email || triggerData.customer_email || 'nguyenphucphi213@gmail.com',\n    customer_telegram_id: prev.customer_telegram_id || triggerData.chat_id || '7919420845'\n  }\n}];"
