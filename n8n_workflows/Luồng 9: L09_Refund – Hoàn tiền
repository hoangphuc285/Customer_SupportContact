    {
      "parameters": {
        "jsCode": "const orderData = $('Code - Kiểm tra thời hạn đổi trả (7 ngày)').first().json;\nconst extracted = $('Information Extractor').first().json.output || {};\nconst triggerData = $('Code - Chuẩn hóa đầu vào Refund').first().json;\nconst totalAmount = Number(orderData.total_amount) || 0;\nconst shippingFee = Number(orderData.shipping_fee) || 0;\n\nlet refundAmount = totalAmount;\nconst reasonLower = (extracted.reason || triggerData.message || '').toLowerCase();\n\nif (reasonLower.includes('đổi ý') || reasonLower.includes('không thích') || reasonLower.includes('mua nhầm')) {\n  refundAmount = Math.max(0, totalAmount - shippingFee);\n}\n\nconst reqAmt = extracted.amount_requested || triggerData.amount_requested || 0;\nif (reqAmt > 0 && reqAmt < refundAmount) {\n  refundAmount = reqAmt;\n}\n\nreturn [{\n  json: {\n    ...orderData,\n    final_refund_amount: refundAmount,\n    refund_policy_reason: refundAmount === totalAmount ? 'Hoàn 100% (lỗi kỹ thuật/giao hàng)' : 'Hoàn tiền hàng trừ phí ship (lý do cá nhân)',\n    reason: extracted.reason || triggerData.content_original || 'Khách hàng yêu cầu hoàn tiền'\n  }\n}];"
      },
