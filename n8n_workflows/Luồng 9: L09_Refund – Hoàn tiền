      "parameters": {
        "jsCode": "const order = $input.first().json;\nconst isDelivered = order.order_status === 'DELIVERED';\nconst alreadyRefunded = order.order_status === 'REFUNDED' || order.order_status === 'CANCELLED';\n\nlet validStatus = true;\nlet reason = 'Hợp lệ';\n\nif (!isDelivered) {\n  validStatus = false;\n  reason = `Đơn hàng đang ở trạng thái ${order.order_status}, chưa được giao thành công.`;\n} else if (alreadyRefunded) {\n  validStatus = false;\n  reason = `Đơn hàng đã được hoàn tiền hoặc đã hủy trước đó.`;\n}\n\nreturn [{\n  json: {\n    ...order,\n    is_delivered: isDelivered,\n    already_refunded: alreadyRefunded,\n    status_valid: validStatus,\n    status_check_reason: reason\n  }\n}];"
