      "parameters": {
        "jsCode": "// Phân loại lỗi: tạm thời vs vĩnh viễn\nconst meta   = $('Code – Định dạng theo kênh').first().json;\nconst errObj = $input.first()?.json || {};\nconst errMsg = JSON.stringify(errObj);\n\n// Lỗi vĩnh viễn: bot bị block, chat_id sai, email không tồn tại\nconst isPermanent = errMsg.includes('403')\n  || errMsg.includes('400')\n  || errMsg.includes('chat not found')\n  || errMsg.includes('user not found')\n  || errMsg.includes('Invalid destination mailbox');\n\nconst newAttempts = (meta.delivery_attempts || 0) + 1;\n\nreturn [{\n  json: {\n    message_id:         meta.message_id,\n    ticket_id:          meta.ticket_id,\n    delivery_attempts:  newAttempts,\n    delivery_error:     errMsg.substring(0, 500),\n    is_permanent_error: isPermanent,\n    should_stop:        isPermanent || newAttempts >= 3\n  }\n}];"
