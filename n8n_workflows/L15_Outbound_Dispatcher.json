      "parameters": {
        "jsCode": "// Chuẩn hóa nội dung theo kênh gửi\nconst meta       = $('Code – Gộp metadata').first().json;\nconst incoming   = $input.first()?.json || {};\nconst translated = incoming.translated_text || incoming.translatedText || null;\nconst content    = translated || meta.content || '';\n\n// Telegram: escape HTML, cắt tối đa 4096 ký tự\nconst telegramText = content\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .substring(0, 4096);\n\n// Email: thay newline bằng <br>\nconst emailHtml = content.replace(/\\n/g, '<br>');\n\n// Zalo/Messenger: cắt theo giới hạn\nconst zaloText      = content.substring(0, 2000);\nconst messengerText = content.substring(0, 2000);\n\nreturn [{\n  json: {\n    ...meta,\n    content_final:   content,\n    telegram_text:   telegramText,\n    email_html:      emailHtml,\n    zalo_text:       zaloText,\n    messenger_text:  messengerText,\n    translation_used: !!translated\n  }\n}];"
      },
