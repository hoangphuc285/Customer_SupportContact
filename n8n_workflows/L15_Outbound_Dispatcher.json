        "jsCode": "// Lấy provider_message_id từ kết quả gửi (Telegram, Zalo, Messenger)\nconst meta = $('Code – Định dạng theo kênh').first().json;\nlet providerMsgId = null;\n\ntry {\n  const result = $input.first()?.json;\n  // Telegram trả về { message_id: 123, ... }\n  if (result?.message_id) providerMsgId = String(result.message_id);\n  // Zalo trả về { data: { message_id: '...' } }\n  if (result?.data?.message_id) providerMsgId = result.data.message_id;\n  // Messenger trả về { message_id: 'mid.xxx' }\n  if (result?.message_id) providerMsgId = result.message_id;\n} catch(e) {}\n\nreturn [{\n  json: {\n    message_id:         meta.message_id,\n    ticket_id:          meta.ticket_id,\n    channel:            meta.channel,\n    provider_message_id: providerMsgId,\n    sent_at:            new Date().toISOString()\n  }\n}];"
      },
