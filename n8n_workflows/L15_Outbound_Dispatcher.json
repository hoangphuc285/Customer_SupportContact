    {
      "parameters": {
        "jsCode": "// Merge ticket metadata with dispatch payload\nconst ticketMeta = $('MySQL – Lấy ticket, khách, kênh').first()?.json || {};\nconst params     = $('Edit Fields – Chuẩn hóa đầu vào').first().json;\n\n// Lấy message_id từ bước Insert nếu vừa tạo mới\nlet messageId = params.message_id;\nif (!messageId) {\n  const inserted = $('MySQL – Insert message PENDING').first()?.json;\n  messageId = inserted?.new_message_id || inserted?.insertId || null;\n}\n\nconst channel = params.channel_override || ticketMeta.channel || 'WEB';\n\nreturn [{\n  json: {\n    ticket_id:      ticketMeta.ticket_id || params.ticket_id,\n    ticket_code:    ticketMeta.ticket_code,\n    message_id:     messageId,\n    content:        params.content,\n    sender_type:    params.sender_type,\n    channel:        channel,\n    ai_locked:      ticketMeta.ai_locked,\n    delivery_status: ticketMeta.delivery_status || 'PENDING',\n    delivery_attempts: ticketMeta.delivery_attempts || 0,\n    needs_translation: params.needs_translation,\n    reply_markup:   params.reply_markup,\n    // Customer contact info\n    customer_name:          ticketMeta.customer_name || 'Quý khách',\n    customer_email:         ticketMeta.customer_email,\n    customer_telegram_id:   ticketMeta.customer_telegram_id,\n    customer_zalo_id:       ticketMeta.customer_zalo_id,\n    customer_messenger_id:  ticketMeta.customer_messenger_id,\n    preferred_language:     ticketMeta.preferred_language || 'vi'\n  }\n}];"
      },
