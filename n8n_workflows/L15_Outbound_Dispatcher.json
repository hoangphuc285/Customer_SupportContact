      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id AS ticket_id, t.ticket_code, t.channel, t.ai_locked,\n       c.full_name AS customer_name, c.email AS customer_email,\n       c.telegram_id AS customer_telegram_id, c.zalo_id AS customer_zalo_id,\n       c.messenger_id AS customer_messenger_id, c.preferred_language,\n       m.id AS message_id, m.delivery_status, m.delivery_attempts\nFROM tickets t\nLEFT JOIN customers c ON t.customer_id = c.id\nLEFT JOIN messages m ON m.id = $1\nWHERE t.id = $2\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$(\"Edit Fields – Chuẩn hóa đầu vào\").first().json.message_id || $(\"MySQL – Insert message PENDING\").first()?.json?.insertId || 0, $(\"Edit Fields – Chuẩn hóa đầu vào\").first().json.ticket_id] }}"
