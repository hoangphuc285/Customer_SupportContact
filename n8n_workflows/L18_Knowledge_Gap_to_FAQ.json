      "id": "bd01edba-b590-4310-8dad-74a318c6e1da",
      "name": "Code – Chuẩn hóa hành động duyệt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        860
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst d = raw.body || raw;\nconst draftId = Number(d.draft_id || d.draftId);\nconst action = String(d.action || 'APPROVE').toUpperCase();\nconst title = d.title || 'FAQ #' + draftId;\nconst question = d.question || '';\nconst answer = d.answer || '';\nconst inlineText = `Tiêu đề: ${title}\\nCâu hỏi: ${question}\\nTrả lời: ${answer}`;\nreturn [{ json: { draft_id: draftId, action, title, question, answer, category: d.category || 'GENERAL', language: d.language || 'vi', reason: d.reason || 'Bị từ chối bởi người duyệt', inline_text: inlineText } }];"
      }
    },
