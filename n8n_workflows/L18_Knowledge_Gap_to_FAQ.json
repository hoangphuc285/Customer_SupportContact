    {
      "id": "d54988df-ad5c-4c01-a641-ed4ea2c3f8de",
      "name": "Code – Làm sạch & Đếm tần suất",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json).filter(x => x && x.id);\nif (items.length === 0) return [{ json: { has_gaps: false, gaps: [], total: 0 } }];\n\nconst dedup = new Map();\nfor (const g of items) {\n  const key = (g.rewrittenQuery || g.question || '').trim().toLowerCase();\n  if (!key) continue;\n  if (!dedup.has(key)) {\n    dedup.set(key, {\n      query: (g.rewrittenQuery || g.question).trim(),\n      count: 1,\n      gap_ids: [g.id],\n      ticket_ids: g.ticketId ? [g.ticketId] : []\n    });\n  } else {\n    const cur = dedup.get(key);\n    cur.count += 1;\n    cur.gap_ids.push(g.id);\n    if (g.ticketId && !cur.ticket_ids.includes(g.ticketId)) cur.ticket_ids.push(g.ticketId);\n  }\n}\nreturn [{ json: { has_gaps: dedup.size > 0, total: items.length, unique_gaps: Array.from(dedup.values()) } }];"
      }
    },
    {
