    {
      "id": "cab8b0ed-d914-4633-b3ce-259ce7fe4187",
      "name": "Code – Thống kê báo cáo tuần",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        40
      ],
      "parameters": {
        "jsCode": "const groups = $input.all().map(i => i.json);\nconst sorted = [...groups].sort((a, b) => (b.total_count || 0) - (a.total_count || 0)).slice(0, 5);\nconst lines = sorted.map((g, idx) => `${idx + 1}. ${g.topic || g.representative_query} (${g.total_count || 1} lượt)`);\nreturn [{ json: { summary: lines.length ? lines.join('\\n') : 'Không có chủ đề thiếu tri thức mới trong tuần.' } }];"
      }
    },
