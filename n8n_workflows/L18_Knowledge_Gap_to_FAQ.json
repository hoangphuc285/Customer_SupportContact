      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.ticket_id, m.content_original, m.created_at\nFROM messages m\nWHERE m.sender_type = 'STAFF'\n  AND FIND_IN_SET(m.ticket_id, $1) > 0\nORDER BY m.created_at DESC\nLIMIT 5;",
