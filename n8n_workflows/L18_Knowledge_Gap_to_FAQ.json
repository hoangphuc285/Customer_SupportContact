      "name": "Code – Đánh giá độ trùng kho KB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        280
      ],
      "parameters": {
        "jsCode": "const group = $('Loop Over Items – Từng nhóm câu hỏi').item.json;\nconst docs = $input.all().map(i => i.json);\nconst topScore = docs.reduce((mx, d) => Math.max(mx, Number(d.score || d.metadata?.score || 0)), 0);\nreturn [{ json: { ...group, top_score: topScore, already_exists: topScore >= 0.75 } }];"
      }
