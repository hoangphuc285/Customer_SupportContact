      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\n// 1. Thống kê số lượng ticket\nconst totalTickets = items.length;\nconst closedTickets = items.filter(t => ['CLOSED', 'RESOLVED'].includes(t.status)).length;\nconst openTickets = totalTickets - closedTickets;\n\n// 2. Thống kê mức độ hài lòng (CSAT)\nconst ratedTickets = items.filter(t => t.satisfaction);\nconst satisfiedCount = items.filter(t => t.satisfaction === 'SATISFIED').length;\nconst csatRate = ratedTickets.length > 0 ? Math.round((satisfiedCount / ratedTickets.length) * 100) : 100;\n\n// 3. Phân bổ theo phòng ban\nconst deptStats = {\n  CSKH: 0,\n  KY_THUAT: 0,\n  THANH_TOAN: 0,\n  OTHER: 0\n};\n\nitems.forEach(t => {\n  const cat = t.category || 'OTHER';\n  if (['REFUND', 'PAYMENT'].includes(cat)) deptStats.THANH_TOAN++;\n  else if (['WARRANTY', 'PRODUCT_SUPPORT'].includes(cat)) deptStats.KY_THUAT++;\n  else deptStats.CSKH++;\n});\n\n// 4. Gom danh sách các ticket để gửi cho AI phân tích điểm nghẽn\nconst recentIssues = items\n  .slice(0, 15)\n  .map(t => `- [${t.category || 'OTHER'}]: ${t.subject || 'Không có tiêu đề'}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    totalTickets,\n    closedTickets,\n    openTickets,\n    csatRate,\n    deptStats,\n    recentIssues\n  }\n}];"
      },
