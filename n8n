      "parameters": {
        "jsCode": "const input = $('5. Đánh giá Priority').first().json;\n\nconst rawText =\n  input.response?.generations?.[0]?.[0]?.text ||\n  input.text ||\n  '';\n\nconst cleanText = rawText\n  .replace(/^```json\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nconst result = JSON.parse(cleanText);\n\nconst priority = result.priority;\n\nconst slaMap = {\n  URGENT: 2,\n  HIGH: 2,\n  MEDIUM: 8,\n  LOW: 24\n};\n\nconst slaHours = slaMap[priority] || 24;\n\n// Thời gian hiện tại\nconst deadline = new Date();\ndeadline.setHours(deadline.getHours() + slaHours);\n\n// LocalDateTime: yyyy-MM-ddTHH:mm:ss\nconst slaDueAt = [\n  deadline.getFullYear(),\n  String(deadline.getMonth() + 1).padStart(2, '0'),\n  String(deadline.getDate()).padStart(2, '0')\n].join('-') + 'T' +\n[\n  String(deadline.getHours()).padStart(2, '0'),\n  String(deadline.getMinutes()).padStart(2, '0'),\n  String(deadline.getSeconds()).padStart(2, '0')\n].join(':');\n\nreturn [{\n  json: {\n    priority,\n    slaHours,\n    slaDueAt\n  }\n}];"
      },
